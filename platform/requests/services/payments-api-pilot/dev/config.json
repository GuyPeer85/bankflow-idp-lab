{
  "apiVersion": "platform.bankflow.io/v1alpha1",
  "kind": "ServiceRequest",
  "metadata": {
    "name": "payments-api-pilot",
    "owner": "payments-team"
  },
  "spec": {
    "workloadType": "http-api",
    "environment": "dev",
    "clusterClass": "general",
    "goldenPath": {
      "name": "http-api",
      "channel": "pilot",
      "version": "1.1.0-beta.1"
    },
    "image": {
      "repository": "bankflow/payments-api",
      "tag": "1.0.0"
    },
    "size": "small",
    "replicas": 1,
    "exposure": "internal",
    "features": {
      "pilotMode": true
    },
    "exception": {
      "id": "PILOT-001",
      "reason": "בדיקת תצורה ניסיונית בלי להשפיע על payments-api הקיים",
      "approvedBy": "platform-team",
      "expiresAt": "2026-11-30"
    }
  }
}